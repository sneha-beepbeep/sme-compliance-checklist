# Copy to .env and fill in real values for your environment. Never commit
# the real .env — see the repo's top-level .gitignore (the same
# phase-*/.env pattern Phase 0 established covers phase-1/.env too).
#
# Read entirely via getenv() in api/db.php / api/contact.php — nothing is
# hardcoded in application code, so the same code runs unmodified against
# local Docker, production managed hosting, and a future self-hosted box
# (portability requirement carried over from Phase 0's /plan).

# --- Database (api/db.php) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=sme_compliance_p1
DB_USER=app
DB_PASSWORD=change_me

# Only used by docker-compose.yml to seed the local MariaDB container's
# root password — not read by application code.
DB_ROOT_PASSWORD=change_me_too

# --- Analytics (public/config.php -> public/assets/analytics.js) ---
# GA4 Measurement ID (format: G-XXXXXXXXXX). Leave unset/blank until a
# real GA4 property exists for Phase 1 (/plan Open Question 7 — same
# property as Phase 0, or a new one, is a GA4-admin decision, not a code
# one) — analytics.js deliberately skips loading gtag.js entirely when
# this is empty, rather than requesting a fake ID.
GA_MEASUREMENT_ID=

# --- Contact-form notification (api/contact.php, US-10) ---
# Recipient for the best-effort sales/CS notification email fired when a
# visitor submits the "Still stuck? Talk to us" contact form. Leave
# unset/blank to skip sending entirely (the contact_requests row is still
# recorded either way — see db/schema.sql's notified_at column).
#
# Deliverability of PHP's mail() on the real production host is
# UNVERIFIED until tested for real (/build default #3) — same category
# of open item Phase 0 carried for GA4/env-vars before its own real
# deploy. If mail() proves unreliable in practice, `notified_at IS NULL`
# in contact_requests is the queryable fallback to find requests that
# still need a manual follow-up.
NOTIFY_EMAIL=

# --- Env loader (api/env.php) ---
# Only needed if the real .env file must live somewhere other than
# phase-1/.env (e.g. a host that requires config outside the document
# root). Leave unset to use the default.
# APP_ENV_FILE=/absolute/path/to/.env
