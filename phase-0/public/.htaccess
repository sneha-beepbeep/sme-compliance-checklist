# Canonical-URL handling for https://compliance.gro-better.com/
# (https, non-www, subdomain root) — design-spec.md 1.1/1.4, updated
# 2026-09-09 when the canonical URL moved from an apex+path form
# (gro-better.com/compliance) to this dedicated subdomain's root. The
# "zero broken-link" quality bar is measured against that exact URL, so
# every variant below must resolve to it rather than silently serving
# content at multiple effective URLs.
#
# Assumption this rewrite depends on: compliance.gro-better.com's
# document root is dedicated to this app (assets/ and api/ live at the
# subdomain's root; see public/assets/form.js's API_URL comment). Because
# the canonical path is now the subdomain root itself, Apache's default
# document (index.html) already serves it directly — no virtual-path
# rewrite is needed for that part. The old "/compliance" virtual path is
# kept below only as a redirect, for anything that might already point at
# it.
#
# To be re-verified against the real lima-city vhost after this change is
# redeployed (Day 2, 2026-09-09) — see phase-0/deploy/README.md's
# checklist.

# Deny direct web access to the .env file and raw .sql files. In the
# deployed layout, public/ and api/ are merged into a single document
# root (see Dockerfile's comment on this), and api/env.php's default
# config path (phase-0/.env locally) resolves to that same document
# root's top level in production — so without this rule, .env would be
# directly downloadable. Written for both Apache 2.4 (mod_authz_core)
# and 2.2 (mod_access_compat) syntax since lima-city's Apache version
# hasn't been confirmed. Re-confirm after this change is redeployed that
# this still blocks the request (e.g. `curl -I
# https://compliance.gro-better.com/.env` should return 403, not 200).
<FilesMatch "(^\.env$|\.sql$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Disable Apache's directory-listing (mod_autoindex) so requests to
# directories without an index file (e.g. /api/, /assets/) don't expose
# the app's internal file inventory (filenames, sizes, timestamps). No
# secrets are served this way today (db.php/env.php echo nothing), but
# this is unnecessary information disclosure on a page handling EU
# personal data, and it's inconsistent with the .env/.sql hardening
# above. Added post-/test (finding 1.3).
Options -Indexes

RewriteEngine On

# Force https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old apex+path canonical form (gro-better.com/compliance), now retired in
# favor of the subdomain root (compliance.gro-better.com/). The campaign
# hadn't gone out yet when this changed, so there's no real risk of an
# already-shared /compliance link — this redirect exists purely for
# safety/hygiene rather than a known broken-link case.
RewriteRule ^compliance/?$ / [R=301,L]

# /privacy-policy — serves public/privacy-policy.html internally (no
# redirect, no .html in the resolved URL), matching the clean-URL form
# index.html's signup consent line and cookie banner link to (both
# previously pointed at a 404 before this page existed). Added 2026-09-09.
RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
