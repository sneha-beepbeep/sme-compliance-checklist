# Copy to .env and fill in real values for your environment. Never commit
# the real .env — see the repo's top-level .gitignore.
#
# Read entirely via getenv() in api/db.php — nothing is hardcoded in
# application code, so the same code runs unmodified against local
# Docker, lima-city managed hosting, and a future self-hosted box
# (portability requirement from /plan).

# --- Database (api/db.php) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=sme_compliance
DB_USER=app
DB_PASSWORD=change_me

# Only used by docker-compose.yml to seed the local MariaDB container's
# root password — not read by application code.
DB_ROOT_PASSWORD=change_me_too
