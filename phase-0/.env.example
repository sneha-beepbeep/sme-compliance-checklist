# Copy to .env and fill in real values for your environment. Never commit
# the real .env — see the repo's top-level .gitignore.
#
# Read entirely via getenv() in api/db.php — nothing is hardcoded in
# application code, so the same code runs unmodified against local
# Docker, lima-city managed hosting, and a future self-hosted box
# (portability requirement from /plan).

# --- Database (api/db.php) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=sme_compliance
DB_USER=app
DB_PASSWORD=change_me

# Only used by docker-compose.yml to seed the local MariaDB container's
# root password — not read by application code.
DB_ROOT_PASSWORD=change_me_too

# --- Analytics (public/config.php -> public/assets/analytics.js) ---
# GA4 Measurement ID (format: G-XXXXXXXXXX). Leave unset/blank until a
# real GA4 property exists — analytics.js deliberately skips loading
# gtag.js entirely when this is empty, rather than requesting a fake ID.
GA_MEASUREMENT_ID=

# --- Env loader (api/env.php) ---
# Only needed if the real .env file must live somewhere other than
# phase-0/.env (e.g. a host that requires config outside the document
# root). Leave unset to use the default.
# APP_ENV_FILE=/absolute/path/to/.env
