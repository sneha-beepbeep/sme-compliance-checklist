# Agency homepage (gro-better.com). Canonical: https://gro-better.com/
# Independent of phase-0/public/.htaccess (compliance.gro-better.com).

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https + bare domain (www -> apex) in a single hop.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://gro-better.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve dotfiles other than this one.
<FilesMatch "^\.(?!htaccess$)">
  Require all denied
</FilesMatch>
